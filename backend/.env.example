# SmartSeek backend config — copy to .env and fill in
# Stripe: get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Public URL used for Stripe success/cancel redirects (set on Railway)
PUBLIC_BASE_URL=http://127.0.0.1:9091
# Postgres on Railway (leave unset locally = SQLite)
# DATABASE_URL=postgresql://user:pass@host:5432/smartseek
PORT=9091
